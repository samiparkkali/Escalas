# Copy the variables you need into your shell or your host's settings.
# The backend reads them from the environment; it does not load this file.

# development allows the built-in SECRET_KEY; anything else requires SECRET_KEY.
APP_ENV=development
# Required outside development: at least 32 random characters, e.g. the output of
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Unset: local SQLite file backend/escalas.db.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Comma-separated list of allowed browser origins.
FRONTEND_URL=http://localhost:5173
TOKEN_TTL_MINUTES=720
